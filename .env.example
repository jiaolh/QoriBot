# 必填：QQ 开放平台 -> 开发设置（AppSecret 不是旧版 Token）
QQ_APP_ID=
QQ_APP_SECRET=

# 必填：你自己填写 API Key，不要在聊天中发送
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 本机运行优先 websocket；平台只有 HTTP 回调时改为 webhook
QQ_TRANSPORT=websocket
# 按 QQ 官方 2026-08-10 的域名变更使用统一地址
QQ_API_BASE_URL=https://api.bot.qq.com

# 只有 webhook 模式使用：公网 HTTPS 地址映射到这个端口和路径
WEBHOOK_PORT=8080
WEBHOOK_PATH=/qoribot/webhook

# 机器人回答风格；含空格、# 或多行时请保留双引号
SYSTEM_PROMPT="你是一个友好、可靠的中文聊天助手。自然地回应用户，默认简洁，必要时给出具体解释。不确定的事实要如实说明。尽量将回答控制在800字以内。"

# 可选参数；温度留空可省略该参数，适配有固定温度要求的模型
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
HISTORY_ROUNDS=10
SESSION_TTL_MINUTES=30
MAX_SESSIONS=1000
MAX_CONTEXT_CHARS=24000
MAX_INPUT_CHARS=4000
# 按 UTF-8 字节限制单条回复，超出时提示截断
MAX_REPLY_BYTES=3600
MAX_CONCURRENT_REQUESTS=4
USER_COOLDOWN_SECONDS=1
