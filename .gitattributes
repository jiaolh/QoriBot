*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.npmrc text eol=lf
